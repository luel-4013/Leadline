# Copy to .env and fill in only what you need. All values are optional.

# Application
# DEBUG=false
# DATABASE_URL=sqlite+aiosqlite:///./leadline.db

# NVD API key (free): raises the public rate limit from 5 to 50 requests
# per 30 seconds, which makes CPE/CVE correlation much faster.
# https://nvd.nist.gov/developers/request-an-api-key
# NVD_API_KEY=

# Loopback-only by default. Add a reverse-proxy hostname here only if you
# deliberately expose Leadline behind TLS and authentication.
# ALLOWED_HOSTS=["localhost","127.0.0.1","::1","backend","testserver"]

# Optional outbound proxy for scan traffic (not for NVD lookups).
# PROXY_URL=http://127.0.0.1:8080
